pkgname=deetty
pkgver=0.1.0
pkgrel=1
pkgdesc='Zig-native terminal workspace for DINX'
arch=('x86_64' 'aarch64')
url='https://github.com/rufl/DEETTY'
license=('MIT' 'Unicode-3.0' 'Unicode-DFS-2016' 'ICU')
depends=('gtk3' 'libepoxy' 'gtk-layer-shell' 'gtksourceview4')
makedepends=('zig' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  zig build -Doptimize=ReleaseSafe
}

package() {
  cd "$pkgname-$pkgver"
  zig build -Doptimize=ReleaseSafe --prefix "$pkgdir/usr"
}
