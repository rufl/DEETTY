<?xml version="1.0" encoding="UTF-8"?>
<language id="svelte" name="Svelte" version="2.0" _section="Source">
  <metadata>
    <property name="mimetypes">text/x-svelte</property>
    <property name="globs">*.svelte</property>
    <property name="block-comment-start">&lt;!--</property>
    <property name="block-comment-end">--&gt;</property>
  </metadata>
  <styles>
    <style id="comment" name="Comment" map-to="def:comment"/>
    <style id="string" name="String" map-to="def:string"/>
    <style id="tag" name="Tag" map-to="def:statement"/>
    <style id="attribute" name="Attribute" map-to="def:identifier"/>
    <style id="expression" name="Expression" map-to="def:preprocessor"/>
    <style id="keyword" name="Keyword" map-to="def:keyword"/>
  </styles>
  <definitions>
    <context id="comment" style-ref="comment">
      <start>&lt;!--</start><end>--&gt;</end>
    </context>
    <context id="string" style-ref="string">
      <start>"</start><end>"</end>
      <include><context ref="def:escape"/></include>
    </context>
    <context id="expression" style-ref="expression">
      <start>{</start><end>}</end>
      <include><context ref="def:line-continue"/></include>
    </context>
    <context id="tag" style-ref="tag">
      <match>&lt;/?[A-Za-z][A-Za-z0-9:.-]*|/&gt;|&gt;</match>
    </context>
    <context id="attribute" style-ref="attribute">
      <match>(?&lt;=\s)(?:[A-Za-z_:][A-Za-z0-9_:.-]*|on:[A-Za-z]+|bind:[A-Za-z]+|class:[A-Za-z]+|let:[A-Za-z]+|use:[A-Za-z]+|transition:[A-Za-z]+)(?=\s|=|/?>)</match>
    </context>
    <context id="keyword" style-ref="keyword">
      <keyword>if</keyword><keyword>else</keyword><keyword>each</keyword><keyword>await</keyword>
      <keyword>then</keyword><keyword>catch</keyword><keyword>key</keyword><keyword>debug</keyword>
      <keyword>const</keyword><keyword>export</keyword>
    </context>
    <context id="svelte">
      <include>
        <context ref="comment"/><context ref="expression"/><context ref="string"/>
        <context ref="tag"/><context ref="attribute"/><context ref="keyword"/>
      </include>
    </context>
  </definitions>
</language>
