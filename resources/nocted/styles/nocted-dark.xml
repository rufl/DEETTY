<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="nocted-dark" _name="NoctEd Dark" version="1.0">
  <author>DINTTY contributors</author>
  <_description>DINTTY-aligned compact dark editor palette</_description>
  <color name="background" value="#0B0D12"/>
  <color name="foreground" value="#D7DDE8"/>
  <color name="muted" value="#7F8A9C"/>
  <color name="selection" value="#263249"/>
  <color name="pink" value="#F7768E"/>
  <color name="green" value="#9ECE6A"/>
  <color name="yellow" value="#E0AF68"/>
  <color name="blue" value="#8FB8FF"/>
  <color name="violet" value="#BB9AF7"/>
  <color name="orange" value="#FFC777"/>
  <style name="text" foreground="foreground" background="background"/>
  <style name="selection" foreground="foreground" background="selection"/>
  <style name="cursor" foreground="foreground"/>
  <style name="current-line" background="#11151D"/>
  <style name="line-numbers" foreground="muted" background="#11151D"/>
  <style name="right-margin" foreground="#222A38" background="background"/>
  <style name="search-match" foreground="#0B0D12" background="yellow"/>
  <style name="bracket-match" foreground="orange" bold="true"/>
  <style name="bracket-mismatch" foreground="foreground" background="pink"/>
  <style name="def:comment" foreground="muted" italic="true"/>
  <style name="def:string" foreground="yellow"/>
  <style name="def:character" foreground="yellow"/>
  <style name="def:number" foreground="violet"/>
  <style name="def:boolean" foreground="violet"/>
  <style name="def:constant" foreground="violet"/>
  <style name="def:keyword" foreground="pink"/>
  <style name="def:statement" foreground="pink"/>
  <style name="def:type" foreground="blue" italic="true"/>
  <style name="def:function" foreground="green"/>
  <style name="def:identifier" foreground="green"/>
  <style name="def:preprocessor" foreground="blue"/>
  <style name="def:error" foreground="foreground" background="pink"/>
</style-scheme>
