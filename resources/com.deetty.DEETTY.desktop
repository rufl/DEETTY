[Desktop Entry]
Type=Application
Name=DEETTY
GenericName=Terminal Workspace
Comment=Native terminal workspace for Plasma and Noctalia Wayland
TryExec=deetty
Exec=deetty --open-uri %u
Icon=com.deetty.DEETTY
Terminal=false
Categories=System;TerminalEmulator;
MimeType=x-scheme-handler/deetty;
Keywords=terminal;console;shell;command;command-line;tty;pty;workspace;split;tabs;agent;
StartupNotify=true
X-KDE-StartupNotify=true
StartupWMClass=com.deetty.DEETTY
Actions=Show;NewWorkspace;Toggle;

[Desktop Action Show]
Name=Show DEETTY
Exec=deetty --show

[Desktop Action NewWorkspace]
Name=Open New Workspace Window
Icon=window-new
Exec=deetty --new-window

[Desktop Action Toggle]
Name=Show or Hide DEETTY
Exec=deetty --toggle
